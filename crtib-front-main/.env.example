# Public site URL (used for metadataBase, canonicals, OG/Twitter, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://crtib.lu

# CMS API (server-side fetches)
PAYLOAD_API_URL=http://localhost:3000/api

# CMS public URL (browser-side, used for media URLs etc.)
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# Optional: bearer token for authenticated Payload requests
PAYLOAD_API_TOKEN=

# Revalidation
REVALIDATE_SECRET=
